{
  "CachingOptions": {
    "RedisEnabled": true,
    "RedisConnectionString": "localhost:6379",
    "LocalCacheExpiration" : 5,
    "Expiration": 5
  },
  "BackgroundJobs": {
    "DepartmentCleanupIntervalHours": 24,
    "HardDeleteThresholdMonths" : 1
  },
  "FileServiceOptions": {
    "Url": "http://localhost:5555",
    "TimeoutSeconds": 10,
    "RetryCount": 2,
    "RetryDelayMilliseconds": 200,
    "CircuitSamplingSeconds": 30,
    "CircuitFailureRatio": 0.5,
    "CircuitMinimumThroughput": 10,
    "CircuitBreakSeconds": 15
  },
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5434;Username=postgres;Password=postgres;Database=directory_service_db"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "fileservice",
    "Password": "fileservice",
    "VirtualHost": "/"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Debug",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "System": "Information",
        "System.Net.Http.HttpClient": "Information",
        "Hangfire": "Information",
        "Application": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext:l} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {
        "Name": "Debug"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "IdentityProvider": {
    "Authority": "http://localhost:5200",
    "MetadataAddress": "http://localhost:5200/.well-known/openid-configuration",
    "Audience": "directory_api",
    "RequireHttpsMetadata": false
  },
  "ServiceTokenOptions": {
    "ClientId": "directory-service",
    "ClientSecret": "",
    "Scope": "directory_api",
    "RefreshBeforeExpirationSeconds": 30
  },
  "AuthServiceOptions": {
    "BaseAddress": "http://localhost:5200",
    "TimeoutSeconds": 10
  },
  "AuthUsersSynchronizationOptions": {
    "Enabled": false,
    "IntervalMinutes": 60,
    "PageSize": 100
  },
  "AllowedHosts": "*"
}
