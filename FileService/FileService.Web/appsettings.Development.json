{
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5439;Username=postgres;Password=postgres;Database=fileservice_service_db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Debug",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "System": "Information",
        "System.Net.Http.HttpClient": "Information",
        "Hangfire": "Information",
        "Application": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext:l} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {
        "Name": "Debug"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "AllowedHosts": "*",
  "VideoProcessing": {
    "FfmpegPath": "D:\\Utils\\ffmpeg-master-latest-win64-gpl\\bin\\ffmpeg.exe",
    "FfprobePath": "D:\\Utils\\ffmpeg-master-latest-win64-gpl\\bin\\ffprobe.exe",
    "UseHardwareAcceleration": false,
    "VideoEncoder": "libx264",
    "VideoPreset": "medium",
    "UploadDegreeOfParallelism": 10,
    "MaxRetries": 3,
    "RetryDelaySeconds": 3,
    "ProcessingTimeoutMinutes": 30
  },
  "S3Options": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "WithSsl": false,
    "DownloadUrlExpirationHours": 24,
    "RequiredBuckets": ["videos", "preview", "documents"],
    "UploadUrlExpirationHours": 1,
    "MaxConcurrentRequests": 50
  },
  "IdentityProvider": {
    "Authority": "http://localhost:5200",
    "MetadataAddress": "http://localhost:5200/.well-known/openid-configuration",
    "Audience": "directory_api",
    "RequireHttpsMetadata": false
  },
  "DevAuth": {
    "Enabled": true
  }
}
