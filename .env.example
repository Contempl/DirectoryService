# External ports
NGINX_PORT=80
MINIO_API_PORT=9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_MANAGEMENT_PORT=15672
SEQ_UI_PORT=8081

# Private NuGet feed (replace with credentials that can read the packages)
NUGET_USERNAME=your-github-username
NUGET_PASSWORD=your-github-package-token

# Local authentication. Replace these values before sharing a reachable environment.
DEV_AUTH_ENABLED=true
JWT_ISSUER=http://localhost
JWT_AUDIENCE=http://localhost
JWT_SECRET=local-development-only-secret-change-before-use-123456789
AdminOptions__Username=admin
AdminOptions__FirstName=Local
AdminOptions__LastName=Administrator
AdminOptions__Email=admin@example.local
AdminOptions__Password=LocalDevelopmentAdmin123!

# DirectoryService PostgreSQL
DS_DB_NAME=directory_service_db
DS_DB_USER=directory_service
DS_DB_PASSWORD=local-directory-db-password

# AuthService PostgreSQL
AS_DB_NAME=auth_service_db
AS_DB_USER=auth_service
AS_DB_PASSWORD=local-auth-db-password

# FileService PostgreSQL
FS_DB_NAME=file_service_db
FS_DB_USER=file_service
FS_DB_PASSWORD=local-file-db-password

# Messaging and object storage
RABBITMQ_USER=fileservice
RABBITMQ_PASSWORD=local-rabbitmq-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-minio-password
